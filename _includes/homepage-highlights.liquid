<div class="home-highlights">
  <div class="home-main">
    <section aria-labelledby="selected-awards">
      <header><h2 id="selected-awards">Selected Awards</h2><a href="{{ '/awards/' | relative_url }}">All awards →</a></header>
      <ul class="home-awards">
        <li><span>2026</span><div>ICDM 10-Year Highest Impact Paper Award<small>IEEE ICDM 2026 · for an ICDM 2017 paper</small></div></li>
        <li><span>2026</span><div>Gemini Academic Research Award</div></li>
        <li><span>2025</span><div>Google DeepMind Research Gift</div></li>
        <li><span>2025</span><div>NVIDIA Academic Grant Program</div></li>
        <li><span>2025</span><div>Amazon Research Award</div></li>
      </ul>
    </section>
    <section aria-labelledby="service">
      <header><h2 id="service">Service</h2><a href="{{ '/service/' | relative_url }}">All service →</a></header>
      <dl class="home-roles">
        <dt>Area Chair</dt><dd>ICML, NeurIPS, ICLR, KDD, AAAI, ACL</dd>
        <dt>Action Editor</dt><dd>Transactions on Machine Learning Research</dd>
        <dt>Associate Editor</dt><dd>IEEE Transactions on Neural Networks and Learning Systems</dd>
      </dl>
    </section>
    <section aria-labelledby="current-teaching">
      <header><h2 id="current-teaching">Current Teaching</h2><a href="{{ '/talks/#teaching-at-william--mary' | relative_url }}">All teaching →</a></header>
      <div class="home-course">
        <span>Fall 2026</span>
        <div><a href="{{ '/fall26' | relative_url }}">Trustworthy AI</a><small>DATA 405/603</small>
          <small class="home-next-course">Next semester: <a href="{{ '/spring27' | relative_url }}">Generative AI</a> · Spring 2027</small>
        </div>
      </div>
    </section>
  </div>
  {% if page.news and site.announcements.enabled %}
    <aside class="home-news" aria-labelledby="home-news-title">
      <h2 id="home-news-title">News</h2>
      <ul>
        {% assign recent_news = site.news | sort: 'date' | reverse %}
        {% for item in recent_news limit: 4 %}
          <li>
            <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %-d, %Y' }}</time>
            {% if item.inline %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            {% else %}
              <a href="{{ item.url | relative_url }}">{{ item.title | escape }}</a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
      <a href="{{ '/news/' | relative_url }}">All news →</a>
    </aside>
  {% endif %}
</div>
